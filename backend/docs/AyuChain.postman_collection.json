            },
            "description": "Public.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Manufacturer\",\n  \"email\": \"mfg1@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"manufacturer\"\n}",
              "options": {
