            },
            "description": "Public.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Lab\",\n  \"email\": \"lab1@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"laboratory\"\n}",
              "options": {
                "raw": {
