            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"cust1@test.com\",\n  \"password\": \"secret123\",\n  \"role\": \"customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login (saves token by role)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Change the email to log in as another role. The test script saves the JWT into {{<role>Token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer1@test.com\",\n  \"password\": \"secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "    pm.collectionVariables.set(data.user.role + 'Token', data.token);",
                  "    console.log('Saved token for role: ' + data.user.role);",
                  "}",
                  "pm.test('no password in response', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('\"password\"');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Upload (IPFS)",
      "item": [
        {
          "name": "Upload herb image",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{farmerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/upload/herb-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload",
                "herb-image"
              ]
            },
            "description": "Auth: JWT. Role: farmer. Rate limit 20/15min. Pick a file in the Body tab before sending.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "jpeg / png / webp, max 5MB"
                },
                {
                  "key": "herbId",
                  "value": "{{herbId}}",
                  "type": "text",
                  "description": "Optional. Links the image to a herb so it appears in /api/verify",
                  "disabled": false
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.upload && data.upload.cid) {",
                  "    pm.collectionVariables.set('cid', data.upload.cid);",
                  "    console.log('Saved cid: ' + data.upload.cid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload lab report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{laboratoryToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/upload/lab-report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload",
                "lab-report"
              ]
            },
            "description": "Auth: JWT. Role: laboratory. Rate limit 20/15min.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "PDF only, max 5MB"
                },
                {
                  "key": "herbId",
                  "value": "{{herbId}}",
                  "type": "text",
                  "description": "Optional",
                  "disabled": false
                },
                {
                  "key": "status",
                  "value": "passed",
                  "type": "text",
                  "description": "pending | passed | failed",
                  "disabled": false
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.upload && data.upload.cid) {",
                  "    pm.collectionVariables.set('cid', data.upload.cid);",
                  "    console.log('Saved cid: ' + data.upload.cid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve CID (gateway redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/upload/{{cid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload",
                "{{cid}}"
              ]
            },
            "description": "Public. 302 redirect to the Pinata gateway. Only CIDs this backend uploaded resolve \u2014 404 otherwise."
          }
        }
      ]
    },
    {
      "name": "Batch & QR",
      "item": [
        {
          "name": "Create batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manufacturerToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qr/batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qr",
                "batches"
              ]
            },
            "description": "Auth: JWT. Role: manufacturer or admin. Saves the generated batch_code into {{batchCode}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"herbId\": 1,\n  \"productName\": \"Ashwagandha Churna 100g\",\n  \"quantity\": \"500 units\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.batch && data.batch.batch_code) {",
                  "    pm.collectionVariables.set('batchCode', data.batch.batch_code);",
                  "    console.log('Saved batchCode: ' + data.batch.batch_code);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate QR for batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{manufacturerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qr/generate/{{batchCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qr",
                "generate",
                "{{batchCode}}"
              ]
            },
            "description": "Auth: JWT. Role: manufacturer or admin. Generates the PNG, pins it to IPFS, and stores the CID on the batch."
          }
        },
        {
          "name": "Get QR image (PNG)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/qr/{{batchCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "qr",
                "{{batchCode}}"
              ]
            },
            "description": "Public. Returns a raw image/png. Usable directly as an <img src>."
          }
        }
      ]
    },
    {
      "name": "Public Verification",
      "item": [
        {
          "name": "Verify batch (customer QR scan)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/verify/{{batchCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "verify",
                "{{batchCode}}"
              ]
            },
            "description": "Public, no auth. Returns the full traceability chain: farmer, herb, image CIDs, lab report CIDs + status, manufacturer, blockchain tx hash, tracking timeline."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('no sensitive fields exposed', function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('\"email\"');",
                  "    pm.expect(text).to.not.include('\"phone\"');",
                  "    pm.expect(text).to.not.include('\"password\"');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
